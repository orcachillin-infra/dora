*.orcachill.in {
	import desec
}

orcachill.in {
	import desec
	reverse_proxy luna.ntw.local:3002
}

##
## Static
##

static.orcachill.in {
	import cors {header.origin}
	root /var/www/static
	file_server
}

##
##  Media Server
##

stream.orcachill.in {
	request_body {
		max_size 100MB
	}
	
	reverse_proxy shamu.ntw.local:8096
}

movies.orcachill.in {	
	reverse_proxy shamu.ntw.local:7878
}

tv.orcachill.in {
	reverse_proxy shamu.ntw.local:8989
}

anime.orcachill.in {
	reverse_proxy shamu.ntw.local:8990
}

tidarr.orcachill.in {
	reverse_proxy shamu.ntw.local:8484
}

music.orcachill.in {
	reverse_proxy shamu.ntw.local:4533
}

torrent.orcachill.in {
	reverse_proxy shamu.ntw.local:6500
}

prowlarr.orcachill.in {
	reverse_proxy shamu.ntw.local:9696
}

aio.orcachill.in {
	reverse_proxy shamu.ntw.local:3600
}

##
##  Cloud Services
##

komodo.orcachill.in {
	reverse_proxy amber.ntw.local:9120
}

prometheus.orcachill.in {
	reverse_proxy amber.ntw.local:9090
}

grafana.orcachill.in {
	reverse_proxy amber.ntw.local:3000
}
panel.orcachill.in {
	reverse_proxy 127.0.0.1:8080
}


##
##  Home Services
##

ha.orcachill.in {
	reverse_proxy ha.host.internal:8123
}

tasks.orcachill.in {
    reverse_proxy 127.0.0.1:3456
}

###
### Misc Services
###

photos.orcachill.in {
    reverse_proxy shamu.ntw.local:2283
}

###
### Testing
###

demo.orcachill.in {
    reverse_proxy shamu.ntw.local:3000
}
