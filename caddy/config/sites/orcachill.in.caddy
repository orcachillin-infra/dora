*.orcachill.in {
	import desec
}

orcachill.in {
	import desec
	import error_pages
	reverse_proxy luna.ntw.local:3002
}

##
## Static
##

static.orcachill.in {
	import cors {header.origin}
	import error_pages
	root /var/www/static
	file_server
}

##
##  Media Server
##

stream.orcachill.in {
	import error_pages
	request_body {
		max_size 100MB
	}
	
	reverse_proxy shamu.network.orcachill.in:8096
}

movies.orcachill.in {
	import error_pages
	reverse_proxy shamu.network.orcachill.in:7878
}

tv.orcachill.in {
	import error_pages
	reverse_proxy shamu.network.orcachill.in:8989
}

anime.orcachill.in {
	import error_pages
	reverse_proxy shamu.network.orcachill.in:8990
}

catalog.orcachill.in {
	import error_pages
	reverse_proxy shamu.network.orcachill.in:5055
}

tidarr.orcachill.in {
	import error_pages
	reverse_proxy shamu.network.orcachill.in:8484
}

music.orcachill.in {
	import error_pages
	reverse_proxy shamu.network.orcachill.in:4533
}

torrent.orcachill.in {
	import error_pages
	reverse_proxy shamu.network.orcachill.in:6500
}

prowlarr.orcachill.in {
	import error_pages
	reverse_proxy shamu.network.orcachill.in:9696
}

aio.orcachill.in {
	import error_pages
	reverse_proxy shamu.network.orcachill.in:3600
}

##
##  Cloud Services
##

komodo.orcachill.in {
	import error_pages
	reverse_proxy 127.0.0.1:9120
}

vault.orcachill.in {
	import error_pages
	reverse_proxy 127.0.0.1:8080
}

prometheus.orcachill.in {
	import error_pages
	reverse_proxy amber.ntw.local:9090
}

grafana.orcachill.in {
	import error_pages
	reverse_proxy amber.ntw.local:3000
}
panel.orcachill.in {
	import error_pages
	reverse_proxy 127.0.0.1:8080
}


##
##  Home Services
##

ha.orcachill.in {
	import error_pages
	reverse_proxy ha.host.internal:8123
}

