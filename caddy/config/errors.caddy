(error_pages) {
	@html_request header Accept *text/html*
	intercept @html_request {
		@error status 4xx 5xx
		handle_response @error {
			root * /var/www/errors
			vars error_status {resp.status_code}
			rewrite * /error.html
			header {
				Content-Type "text/html; charset=utf-8"
				-Content-Encoding
			}
			templates
			file_server {
				status {resp.status_code}
			}
		}
	}

	# handle_errors 4xx 5xx {
	handle_errors 5xx {
		root * /var/www/errors
		vars error_status {err.status_code}
		rewrite * /error.html
		templates
		file_server {
			status {err.status_code}
		}
	}
}
